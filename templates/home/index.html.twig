{% extends 'base.html.twig' %}

{# ---- Dés en SVG, réutilisables ---- #}
{% macro d20() %}
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" aria-hidden="true">
        <polygon points="50,5 90,28 90,72 50,95 10,72 10,28"/>
        <polygon points="50,18 73,38 50,62 27,38"/>
        <path d="M50,5 50,18 M10,28 27,38 M90,28 73,38 M27,38 10,72 M73,38 90,72 M50,62 50,95 M50,62 10,72 M50,62 90,72"/>
        <text x="50" y="46" text-anchor="middle" font-size="17" stroke="none" fill="currentColor" font-family="Cinzel, serif" font-weight="700">20</text>
    </svg>
{% endmacro %}

{% macro d6_1() %}
    <img src="{{asset('img/dice_one.svg')}}" alt="">
{% endmacro %}

{% macro d6_2() %}
    <img src="{{asset('img/dice_two.svg')}}" alt="">
{% endmacro %}

{% macro d6_4() %}
    <img src="{{asset('img/dice_four.svg')}}" alt="">
{% endmacro %}

{% macro d6_6() %}
    <img src="{{asset('img/dice_six.svg')}}" alt="">
{% endmacro %}

{% macro logo_gold() %}
    <img src="{{asset('img/logo_gold_simple.svg')}}" alt="">
{% endmacro %}

{% macro logo_main() %}
    <img src="{{asset('img/logo_main_simple.svg')}}" alt="">
{% endmacro %}

{% macro logo_red() %}
    <img src="{{asset('img/logo_red_simple.svg')}}" alt="">
{% endmacro %}

{% import _self as dice %}

{% block body %}

{# =================== HERO =================== #}
<section class="hero">
    <div class="hero__dice" aria-hidden="true">
        <span class="die-deco d2">{{ dice.logo_gold() }}</span>
        <span class="die-deco d1">{{ dice.logo_main() }}</span>
        <span class="die-deco d3">{{ dice.logo_red() }}</span>
        <span class="die-deco d4">{{ dice.logo_main() }}</span>
        <span class="die-deco d5">{{ dice.logo_gold() }}</span>
    </div>
    <div class="hero__inner">
        <p class="hero__eyebrow">Maître du jeu · Jeu de rôle sur table</p>
        <h1 class="hero__title">Lancez les dés.<br>Vivez l'<em>aventure</em>.</h1>
        <p class="hero__subtitle">
            Réunissez votre groupe, je m'occupe du reste. Dice Adventure crée et
            anime pour vous des sessions de jeu de rôle plateau façon Donjons&nbsp;&amp;&nbsp;Dragons :
            une histoire sur mesure, des donjons à explorer, et un maître du jeu pour vous guider.
        </p>
        <div class="hero__actions">
            <a class="btn btn--primary" href="#contact">⚔️ Réserver une partie</a>
            <a class="btn btn--ghost" href="#formules">Voir les formules</a>
        </div>
        <ul class="hero__stats">
            <li><span class="num">120+</span><span class="lbl">parties menées</span></li>
            <li><span class="num">3 à 6</span><span class="lbl">joueurs par table</span></li>
            <li><span class="num">100%</span><span class="lbl">sur mesure</span></li>
        </ul>
    </div>
</section>

{# =================== POURQUOI / AVENTURE =================== #}
<section class="section" id="aventure">
    <div class="section__head">
        <span class="section__kicker">Pourquoi Dice Adventure</span>
        <h2>Une table, des dés, mille histoires</h2>
        <p>Pas besoin d'être un joueur expérimenté. Apportez votre curiosité, je fournis l'aventure.</p>
    </div>
    <div class="grid grid--3">
        <article class="card">
            <div class="card__die">{{ dice.logo_gold() }}</div>
            <h3>Des histoires sur mesure</h3>
            <p>Chaque scénario est écrit pour votre groupe : univers, difficulté, ton, tout est adapté à vos envies, que vous soyez des débutants ou rôlistes aguerris.</p>
        </article>
        <article class="card">
            <div class="card__die">{{ dice.logo_main() }}</div>
            <h3>Tout le matériel fourni</h3>
            <p>Dés, fiches de personnages, plateaux et figurines : sortez simplement le sac à dos, ouvrez une potion, et plongez dans le donjon.</p>
        </article>
        <article class="card">
            <div class="card__die">{{ dice.logo_red() }}</div>
            <h3>Un maître du jeu dédié</h3>
            <p>Je gère les règles, les monstres et le suspense pour que vous viviez chaque rebondissement sans jamais décrocher de l'histoire.</p>
        </article>
    </div>
</section>

{# =================== NEWS =================== #}
<section class="section--alt" id="news"{% if actualites is empty %} hidden{% endif %}>
    <div class="section__inner">
        <div class="section__head">
            <span class="section__kicker">Les infos de Dice Adventure</span>
            <h2>Quoi de neuf en ce moment ?</h2>
            <p>Découvrez nos dernières actualités.</p>
        </div>
        <div class="news-grid">
            {% for actu in actualites %}
                <article class="news-card{{ actu.image ? ' news-card--with-img' }}">
                    {% if actu.image %}
                        <img class="news-card__img" src="{{ asset('uploads/actualites/' ~ actu.image) }}" alt="" loading="lazy">
                    {% endif %}
                    <div class="news-card__body">
                        <h3 class="news-card__title">{{ actu.titre }}</h3>
                        <p class="news-card__text">{{ actu.description }}</p>
                    </div>
                </article>
            {% endfor %}
        </div>
    </div>
</section>

{# =================== DÉROULÉ =================== #}
<section class="section" id="deroule">
    <div class="section__head">
        <span class="section__kicker">Comment ça se passe</span>
        <h2>De l'idée* à la table en 4 jets de dé</h2>
    </div>
    {# data-dice-faces : les faces de dé disponibles pour le tirage aléatoire.
       ⚠️ Seules les faces 1, 2, 4 et 6 existent en SVG. Pour un vrai d6, ajoutez
       dice_three.svg et dice_five.svg dans public/img puis leurs deux URLs ici. #}
    <div class="steps" data-dice-faces='[
        "{{ asset('img/dice_one.svg') }}",
        "{{ asset('img/dice_two.svg') }}",
        "{{ asset('img/dice_four.svg') }}",
        "{{ asset('img/dice_six.svg') }}"
    ]'>
        <div class="step">
            <div class="step__die">{{ dice.d6_1() }}</div>
            <h3>Premier jet : On échange</h3>
            <p>Vous me dites qui joue, vos envies et votre niveau. Je propose un univers.</p>
        </div>
        <div class="step">
            <div class="step__die">{{ dice.d6_2() }}</div>
            <h3>Second jet : Je prépare</h3>
            <p>J'écris le scénario, crée vos personnages et prépare tout le matériel.</p>
        </div>
        <div class="step">
            <div class="step__die">{{ dice.d6_4() }}</div>
            <h3>Troisième jet : On se réunit</h3>
            <p>Chez vous ou sur le lieu de votre choix, autour de la table on se prépare à l'aventure.</p>
        </div>
        <div class="step">
            <div class="step__die">{{ dice.d6_6() }}</div>
            <h3>Quatrième jet : On joue</h3>
            <p>Je mène l'aventure, vous prenez les décisions. Arriverez-vous au bout de la quête ?</p>
        </div>
    </div>
    <div style="margin-top: 10%;">
    <p>*Merci de me contacter dans un délai d'une semaine avant la date souhaitée pour votre aventure.</p>
    </div>
</section>

<script>
    (function () {
        var steps = document.querySelector('.steps[data-dice-faces]');
        if (!steps) { return; }

        var faces;
        try { faces = JSON.parse(steps.getAttribute('data-dice-faces')); }
        catch (e) { return; }
        if (!faces || !faces.length) { return; }

        steps.querySelectorAll('.step').forEach(function (step) {
            var img = step.querySelector('.step__die img');
            if (!img) { return; }

            var bouton = document.createElement('button');
            bouton.type = 'button';
            bouton.className = 'btn btn--dark step__roll';
            bouton.textContent = '🎲 Lancer le dé';
            step.appendChild(bouton);

            bouton.addEventListener('click', function () {
                var face = faces[Math.floor(Math.random() * faces.length)];
                img.classList.remove('is-rolling');
                void img.offsetWidth;              /* redémarre l'animation */
                img.classList.add('is-rolling');
                img.src = face;
            });
        });
    })();
</script>

{# =================== LE MAÎTRE DU JEU =================== #}
<section class="mj" id="maitre-du-jeu">
    <div class="mj__inner">
        <div class="mj__portrait">
            <span class="die-deco">{{ dice.d20() }}</span>
        </div>
        <div>
            <span class="section__kicker">Le maître du jeu</span>
            <h2>Votre guide dans le donjon</h2>
            <p>
                Rôliste depuis plus de dix ans et maître du jeu passionné, je consacre
                aujourd'hui mon activité à une seule chose : vous faire
                vivre des aventures mémorables autour d'une table.
            </p>
            <p>
                Mon plaisir, c'est de voir un groupe rire, hésiter, triompher — et repartir
                avec des souvenirs. Débutant complet ou vétéran des dés, vous trouverez
                votre place à ma table.
            </p>
            <ul class="mj__tags">
                <li>Donjons &amp; Dragons</li>
                <li>Heroic fantasy</li>
                <li>Enquête &amp; mystère</li>
                <li>Sur mesure</li>
                <li>Tous niveaux</li>
            </ul>
        </div>
    </div>
</section>

{# =================== FORMULES =================== #}
<section class="section--alt" id="formules">
    <div class="section__inner">
        <div class="section__head">
            <span class="section__kicker">Les formules</span>
            <h2>Choisissez votre quête</h2>
            <p>De la première partie d'initiation à la grande campagne épique, il y a une aventure pour chaque groupe.</p>
        </div>
        <div class="grid grid--3">
        {% for prix in tarrif %}
        <article class="formule {{prix.mettreEnAvant ? 'formule--phare' : ''}}">
            {% if prix.mettreEnAvant %}
            <span class="formule__badge">Le plus choisi</span>
            {% endif %}
                <h3>{{prix.nom}}</h3>
                <p class="formule__price">{{prix.prixAffiche}}<span>/ {{prix.prixPar}}</span></p>
                <ul>
                {% for info in prix.infos %}
                    <li>{{info}}</li>
                {% endfor %}
                </ul>
                <a class="btn {{prix.mettreEnAvant ? 'btn--primary' : 'btn--dark'}}" href="#contact">{{prix.formuleContact}}</a>
            </article>
        {% endfor %}
        </div>
        <div>
        <p>*+ Frais kilométriques ({{fraisKilometrique}})</p>
        </div>
    </div>
</section>

{# =================== TÉMOIGNAGES =================== #}
<section class="section" id="temoignages">
    <div class="section__head">
        <span class="section__kicker">Ils ont lancé les dés</span>
        <h2>Ce que disent les aventuriers</h2>
    </div>
    <div class="quotes">
        {% for avis in avisList %}
        <figure class="quote">
            <div class="stars">{% for i in 1..avis.note %}★{% endfor %}{% if avis.note < 5 %}{% for i in avis.note + 1..5 %}☆{% endfor %}{% endif %}</div>
            <p>« {{ avis.message }} »</p>
            <figcaption class="who">— {{ avis.auteur }}{% if avis.infosSuppAuteur %}, {{ avis.infosSuppAuteur }}{% endif %}</figcaption>
        </figure>
        {% else %}
        <p>Soyez les premiers à partager votre aventure !</p>
        {% endfor %}
    </div>
</section>

{# =================== CONTACT =================== #}
<section class="contact" id="contact">
    <div class="contact__inner">
        <div class="contact__intro">
            <span class="section__kicker">Réserver une partie</span>
            <h2>Prêt à entrer dans l'aventure ?</h2>
            <p>
                Remplissez le formulaire ci-présent pour débuter nos échanges.
            </p>
            <ul class="contact__list">
                <li><span class="ico">📜</span> Réponse sous 48&nbsp;h</li>
                <li><span class="ico">🎲</span> Sans engagement</li>
                <li><span class="ico">🧪</span> Débutants bienvenus</li>
            </ul>
        </div>
        <div class="contact-form contact-form--embed">
            {# Le formulaire est hébergé par Google Forms. L'iframe n'est injectée
               qu'après une action explicite du visiteur (ou si le consentement RGPD
               a déjà été donné) : rien n'est transmis à Google sans accord. #}
            <div id="contact-embed"
                 class="contact-embed"
                 data-form-url="https://docs.google.com/forms/d/e/1FAIpQLSdut12ZCrDmev_RxcCfTfBilZfTr91098E1wZGVAJ9EAQA0TQ/viewform?embedded=true">
                <div class="contact-embed__placeholder" id="contact-embed-placeholder">
                    <p class="contact-embed__title">🎲 Formulaire de contact</p>
                    <p class="contact-embed__text">
                        Ce formulaire est hébergé par <strong>Google&nbsp;Forms</strong>. En l'affichant,
                        vous acceptez que workspace.google.com utilise des cookies Google afin de fournir ses services, 
                        d'en améliorer la qualité et d'analyser le trafic. <a href="https://policies.google.com/technologies/cookies?hl=fr" target="_blank">En savoir plus l'utilisation.</a>
                    </p>
                    <button type="button" class="btn btn--primary" id="contact-embed-load">
                        Afficher le formulaire
                    </button>
                    <p class="contact-embed__alt">
                        Vous préférez ne pas l'afficher ici ?
                        <a href="https://docs.google.com/forms/d/e/1FAIpQLSdut12ZCrDmev_RxcCfTfBilZfTr91098E1wZGVAJ9EAQA0TQ/viewform"
                           target="_blank" rel="noopener noreferrer">Ouvrir le formulaire dans un nouvel onglet</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        var zone = document.getElementById('contact-embed');
        if (!zone) { return; }

        var bouton = document.getElementById('contact-embed-load');

        /* Injecte l'iframe Google Forms. Idempotent : un seul chargement possible. */
        function afficherFormulaire() {
            if (zone.querySelector('iframe')) { return; }

            var cadre = document.createElement('iframe');
            cadre.src = zone.getAttribute('data-form-url');
            cadre.title = 'Formulaire de contact Dice Adventure';
            cadre.loading = 'lazy';
            cadre.className = 'contact-embed__iframe';

            var placeholder = document.getElementById('contact-embed-placeholder');
            if (placeholder) { placeholder.remove(); }
            zone.appendChild(cadre);
        }

        bouton.addEventListener('click', afficherFormulaire);

        /* Consentement global déjà accordé : on charge sans redemander.
           La bannière (base.html.twig) émet cet évènement au chargement
           et à chaque nouveau choix. */
        if (window.rgpdChoix === 'accepte') { afficherFormulaire(); }
        document.addEventListener('rgpd:choix', function (e) {
            if (e.detail === 'accepte') { afficherFormulaire(); }
        });
    })();
</script>

{% endblock %}
